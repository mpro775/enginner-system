PROJECT_SLUG=enginner-system
NODE_ENV=production

APP_PORT=3000
API_PREFIX=api/v1
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/maintenance-system

JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

REDIS_URL=rediss://username:password@your-managed-redis-provider:6379
PASSWORD_RESET_OTP_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=600

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="نظام إدارة طلبات الصيانة"

CORS_ORIGIN=https://maintenance.smartagency-ye.com
CACHE_TTL=300
CACHE_MAX=100
THROTTLE_TTL=60
THROTTLE_LIMIT=100
ANALYTICS_TIMEZONE=Asia/Riyadh

MEDIA_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MEDIA_S3_REGION=auto
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET=
MEDIA_SIGNED_URL_TTL_SECONDS=600
MEDIA_MAX_FILES=3
MEDIA_MAX_INPUT_BYTES=8388608
MEDIA_MAX_INPUT_PIXELS=40000000
MEDIA_FULL_MAX_EDGE=1600
MEDIA_THUMB_MAX_EDGE=480
MEDIA_FULL_WEBP_QUALITY=78
MEDIA_THUMB_WEBP_QUALITY=70

VITE_API_URL=https://api-maintenance.smartagency-ye.com/api/v1
VITE_SOCKET_URL=https://api-maintenance.smartagency-ye.com
