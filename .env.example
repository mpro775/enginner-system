# =====================================================
# Docker Compose Environment Variables
# =====================================================
# Copy this file to .env and update the values
# =====================================================

# MongoDB
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme123

# JWT Secrets
# IMPORTANT: Generate strong random strings for production!
# Generate with: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-64-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production-min-64-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# External Redis (no local Redis container is used).
# The endpoint must support EVAL/Lua, multi-key scripts, PTTL, and KEEPTTL.
# Use a TLS (rediss://) endpoint whenever required by the production provider.
REDIS_URL=rediss://username:password@your-managed-redis-provider:6379
PASSWORD_RESET_OTP_SECRET=replace-with-a-long-random-secret
PASSWORD_RESET_OTP_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5
PASSWORD_RESET_TOKEN_TTL_SECONDS=600

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="نظام إدارة طلبات الصيانة"

# CORS
CORS_ORIGIN=https://mohd-morad.pro,https://www.mohd-morad.pro

# Frontend Build Args
VITE_API_URL=https://api.mohd-morad.pro/api/v1
VITE_SOCKET_URL=https://api.mohd-morad.pro

# Cache
CACHE_TTL=300
CACHE_MAX=100

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# IANA timezone used by analytics day/month boundaries and heatmaps.
ANALYTICS_TIMEZONE=Asia/Riyadh
VITE_ANALYTICS_TIMEZONE=Asia/Riyadh
